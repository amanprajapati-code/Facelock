name: Build APK
on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Unzip project and add model
        run: |
          test -f FaceLock.zip || (echo "Upload FaceLock.zip to the repository" && exit 1)
          test -f mobilefacenet.tflite || (echo "Upload mobilefacenet.tflite to the repository" && exit 1)
          unzip -q FaceLock.zip -d project
          mkdir -p project/FaceLock/app/src/main/assets
          cp mobilefacenet.tflite project/FaceLock/app/src/main/assets/

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7

      - name: Build debug APK
        working-directory: project/FaceLock
        run: gradle assembleDebug --no-daemon

      - name: Publish to Releases
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v${{ github.run_number }}
          name: FaceLock v${{ github.run_number }}
          files: project/FaceLock/app/build/outputs/apk/debug/app-debug.apk
